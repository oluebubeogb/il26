# Application
NODE_ENV=production
PORT=3000
APP_URL=https://your-domain.com

# Database (used by docker-compose; change password in production)
POSTGRES_USER=ibeku
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=ibeku_league
DATABASE_URL=postgresql://ibeku:change_me_to_a_strong_password@db:5432/ibeku_league?schema=public

# Primary admin bootstrap (required on first start only)
# Password is hashed; existing primary admin is never reset on restart
PRIMARY_ADMIN_USERNAME=admin
PRIMARY_ADMIN_PASSWORD=change_me_strong_password
PRIMARY_ADMIN_PHONE=08012345678

# Session
SESSION_SECRET=generate_a_long_random_string_at_least_32_chars
COOKIE_SECURE=true

# Logging
LOG_LEVEL=info
