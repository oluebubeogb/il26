# Application
NODE_ENV=production
PORT=3000
APP_URL=https://your-domain.com

# Database
POSTGRES_USER=ibeku
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=ibeku_league
DATABASE_URL=postgresql://ibeku:change_me_to_a_strong_password@db:5432/ibeku_league?schema=public

# Primary admin bootstrap (first start only — never resets existing)
PRIMARY_ADMIN_USERNAME=admin
PRIMARY_ADMIN_PASSWORD=change_me_strong_password
PRIMARY_ADMIN_PHONE=08012345678

# Session
SESSION_SECRET=generate_a_long_random_string_at_least_32_chars
COOKIE_SECURE=true

# Logging
LOG_LEVEL=info

# ─── Phase 2: AI (RunPod OpenAI-compatible) ───
# Leave empty / AI_ENABLED=false to run without AI
AI_ENABLED=false
AI_AUTO_PUBLISH=false
LLM_BASE_URL=https://api.runpod.ai/v2/YOUR_ENDPOINT_ID/openai/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=1500
AI_MAX_JOBS_PER_HOUR=30
